{
  "name": "cryo-mongolia-employee-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static, mobile-first employee ERP frontend for CRYO Mongolia.",
  "scripts": {
    "build": "npm run check && npm test && npm run build:app",
    "build:app": "esbuild ./src/main.js --bundle --format=esm --target=es2022 --minify --outfile=./assets/app.js",
    "check": "node ./scripts/check.mjs",
    "serve": "node ./scripts/serve.mjs",
    "test": "node --test ./tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
